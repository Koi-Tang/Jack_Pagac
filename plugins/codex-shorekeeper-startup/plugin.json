  "author": {
    "name": "Koi-Tang",
    "url": "https://github.com/Koi-Tang"
  },
  "homepage": "https://github.com/Koi-Tang/Jack_Pagac",
  "repository": "https://github.com/Koi-Tang/Jack_Pagac",
  "keywords": [
    "codex",
    "shorekeeper",
    "startup-animation",
    "windows",
